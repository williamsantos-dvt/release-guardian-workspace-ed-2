{
  "name": "xteam-dev-academy-hackathon-challenge",
  "private": true,
  "version": "1.0.0",
  "description": "Release Guardian — deployment readiness service (xTEAM Dev Academy hackathon challenge)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,dashboard -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/dashboard\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "build": "npm run build -w packages/contracts && npm run build -w apps/api",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/dashboard",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:organizer": "vitest run --config vitest.organizer.config.ts",
    "validate": "node scripts/validate.mjs",
    "simulate:pipeline": "node scripts/simulate-pipeline.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/swagger-ui": "6.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
